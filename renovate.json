{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>roleme/workflows//renovate-presets/default.json"],
  "rebaseWhen": "behind-base-branch",
  "platformAutomerge": true,
  "customManagers": [
    {
      "description": "Tool versions pinned in the check scripts that the composite actions and lefthook run.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.lefthook/.+\\.sh$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n[A-Z_]+=(?<currentValue>\\S+)"]
    },
    {
      "description": "Scanner versions pinned in the env block of the third-party scan workflow.",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/third-party-scan-reusable\\.yml$/"],
      "matchStrings": ["# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s+[A-Za-z_]+: (?<currentValue>\\S+)"]
    }
  ],
  "packageRules": [
    {
      "matchDepNames": ["!roleme/workflows"],
      "matchUpdateTypes": ["patch", "minor", "digest"],
      "groupName": "dependencies (non-major)",
      "schedule": ["* 0-3 * * 1"]
    }
  ]
}
